{% extends 'base.html.twig' %}

{% block title %}Mon panier - GreenGoodies
{% endblock %}

{% block body %}

	<section class="cart-page wrapper-1440">

		<h1>Mon panier</h1>

		{# Messages de confirmation #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success">{{ message }}</div>
		{% endfor %}

		{% if not cart or cart.cartItems is empty %}
			<p>Votre panier est vide.</p>
			<a href="{{ path('app_home') }}" class="btn">Retour aux produits</a>

		{% else %}

			<div class="cart-items">

				{% set total = 0 %}

				{% for item in cart.cartItems %}
					{% set lineTotal = item.product.price * item.quantity %}
					{% set total = total + lineTotal %}

					<div class="cart-item">

						<div class="cart-item-left">
							<img src="{{ asset('uploads/' ~ item.product.picture) }}" alt="{{ item.product.name }}" class="cart-item-img">
						</div>

						<div class="cart-item-right">
							<h2 class="cart-item-name">{{ item.product.name }}</h2>

							<p class="cart-item-qty">
								Quantité :
								<strong>{{ item.quantity }}</strong>
							</p>

							<p class="cart-item-price">
								Prix :
								<strong>{{ item.product.price }}€</strong>
							</p>
						</div>

					</div>

				{% endfor %}
			</div>

			<div class="cart-summary">

				<p class="summary-line">
					<span>Total panier :</span>
					<strong>{{ total }}€</strong>
				</p>

				<p class="summary-line">
					<span>Frais de livraison :</span>
					<strong>Offert</strong>
				</p>

				<a href="{{ path('app_cart_validate') }}" class="btn btn-success big-btn">
					Valider la commande
				</a>

			</div>

		{% endif %}

	</section>

{% endblock %}
