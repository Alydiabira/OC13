{% extends 'base.html.twig' %}

{% block title %}Inscription
{% endblock %}

{% block body %}

	<div class="register-page">

		<div class="register-left">
			<img src="{{ asset('images/13.jpg') }}" alt="">
		</div>

		<div class="register-right">

			<h1>Inscription</h1>
			<p class="register-subtitle">Tous les champs sont obligatoires.</p>

			{{ form_start(form) }}

			{# Erreurs globales #}
			{{ form_errors(form) }}

			<div class="form-group">
				{{ form_label(form.lastname, 'Nom') }}
				{{ form_widget(form.lastname) }}
				{{ form_errors(form.lastname) }}
			</div>

			<div class="form-group">
				{{ form_label(form.firstname, 'Prénom') }}
				{{ form_widget(form.firstname) }}
				{{ form_errors(form.firstname) }}
			</div>

			<div class="form-group">
				{{ form_label(form.email, 'Adresse email') }}
				{{ form_widget(form.email) }}
				{{ form_errors(form.email) }}
			</div>

			<div class="form-group">
				{{ form_label(form.password, 'Mot de passe') }}
				{{ form_widget(form.password) }}
				{{ form_errors(form.password) }}
			</div>

			<div class="form-group">
				{{ form_label(form.confirmPassword, 'Confirmation mot de passe') }}
				{{ form_widget(form.confirmPassword) }}
				{{ form_errors(form.confirmPassword) }}
			</div>

			<div class="form-group checkbox-group">
				{{ form_widget(form.acceptCgu) }}
				{{ form_label(form.acceptCgu, "J’accepte les CGU de GreenGoodies") }}
				{{ form_errors(form.acceptCgu) }}
			</div>

			<button class="register-btn">S’inscrire</button>

			{{ form_end(form) }}

			<p class="register-login">
				Déjà un compte ?
				<a href="{{ path('app_login') }}">Se connecter</a>
			</p>

		</div>

	</div>

{% endblock %}
