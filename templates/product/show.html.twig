{% extends 'base.html.twig' %}

{% block title %}
	{{ product.name }}
	- GreenGoodies
{% endblock %}

{% block body %}

	<section class="gg-product-page wrapper-1440">

		<div class="gg-product-image">
			<img src="{{ asset('uploads/' ~ product.picture) }}" alt="{{ product.name }}">
		</div>

		<div class="gg-product-info">

			<h1>{{ product.name }}</h1>

			<p class="gg-product-price">{{ product.price }}
				€</p>

			<p class="gg-product-description">
				{{ product.fullDescription }}
			</p>

			<div class="gg-product-actions">

				{% if not app.user %}
					<a href="{{ path('app_login') }}" class="gg-btn">
						Se connecter pour acheter
					</a>

				{% else %}
					<form method="post" action="{{ path('app_cart_add', { id: product.id }) }}">

						<label for="quantity">Quantité</label>
						<input type="number" id="quantity" name="quantity" min="0" value="{{ quantity > 0 ? quantity : 1 }}">

						<button class="gg-btn">
							{{ quantity > 0 ? 'Mettre à jour' : 'Ajouter au panier' }}
						</button>

					</form>
				{% endif %}

			</div>

		</div>

	</section>


{% endblock %}
